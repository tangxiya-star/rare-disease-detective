# Crusoe Managed Inference
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
LEAD_MODEL=nvidia/Nemotron-3-Super-120B-A12B
CHILD_MODEL=nvidia/Nemotron-3-Nano-30B-A3B

# Literature search (optional; falls back to Europe PMC)
YOUCOM_API_KEY=

# Recursion limits
MAX_DEPTH=3
MAX_NODES_PER_RUN=24
MAX_CONCURRENT_INFERENCE=3
